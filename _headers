# TRUE 82 — Cloudflare Pages security headers (served on every response).
# CSP is deliberately NOT set here yet: it must pin your Clerk Frontend API
# domain, which is per-instance. The finished recipe lives in SECURITY.md §5.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Agent discovery (RFC 8288): homepage advertises machine-readable entry points.
# Every rel below is in the IANA Link Relations registry — describedby (the
# llms.txt that describes this site for agents), help (the how-to explainer),
# canonical (the preferred URL; ?duel=/?league= deep links share this page).
/
  Link: <https://true82.net/llms.txt>; rel="describedby"; type="text/markdown", <https://true82.net/how-it-works/>; rel="help", <https://true82.net/>; rel="canonical"

# The web app manifest (v57): the right type for every browser that asks for it.
/manifest.webmanifest
  Content-Type: application/manifest+json

# v64.1 (speed): the versioned static files never change under their ?v= key, so a returning phone keeps them a year
# and never asks again (no revalidation round trip before the page can draw). The list is tools/cache-keys.json's:
# every reference carries its key and a changed file gets a new one (node tools/cache-keys.js; test.js checks both
# the keys and that this list matches). HTML pages and labels.json are never here: they keep revalidating.
/accounts.js
  Cache-Control: public, max-age=31536000, immutable
